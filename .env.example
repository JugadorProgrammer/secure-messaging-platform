POSTGRES_DB=auth_db
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=change_me_for_local_development

# Published ports on the HOST. Container ports remain 8080 and 5432.
# COORD uses host port 8080 and PostgreSQL 5432.
AUTH_HTTP_HOST_PORT=8080
AUTH_POSTGRES_HOST_PORT=5432
ACCOUNTS_URL=http://host.docker.internal:8081

# External SMTP; local Mailpit overrides these in compose.mailpit.yaml.
AUTH_SMTP_URL=
AUTH_SMTP_FROM=
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_SECURITY=tls
AUTH_COOKIE_SECURE=true
